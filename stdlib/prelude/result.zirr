module prelude

annotation Error {
	@Returns(String)
	toString(@Has(Error) err)
}

union Result {
    data Ok {
		@Any value
	}
    data Err {
		@Has(Error)
		error
	}
}

annotation OkType {
	@Type(AnyType) type
}


annotation ErrType {
	@Type(AnyType) type
}


@json.Inline()
union Optional {
	@json.Type(json.Null)
	data None

	@json.Inline
	data Some {
	   value
	}
}
