mod code.knabel.dev.zirric_lang.zirric.random._t

import tests { Test }
import tests.assert

import random
import arrays

@Test()
fn testSeededIsReproducible() {
	// The whole point of a seeded source: the same seed gives the same run, so code using randomness can be tested.
	const first = random.seeded(42)
	const second = random.seeded(42)
	var same = true
	var i = 0
	for i < 20 {
		if random.int(first, 1000) != random.int(second, 1000) {
			same = false
		}
		i = i + 1
	}
	assert.equal(true, same)
}

@Test()
fn testDifferentSeedsDiffer() {
	const a = random.seeded(1)
	const b = random.seeded(2)
	var differences = 0
	var i = 0
	for i < 20 {
		if random.int(a, 1000000) != random.int(b, 1000000) {
			differences = differences + 1
		}
		i = i + 1
	}
	assert.equal(true, differences > 0)
}

@Test()
fn testIntStaysInRange() {
	const source = random.seeded(7)
	var withinRange = true
	var i = 0
	for i < 200 {
		const value = random.int(source, 10)
		if value < 0 {
			withinRange = false
		}
		if value > 9 {
			withinRange = false
		}
		i = i + 1
	}
	assert.equal(true, withinRange)
}

@Test()
fn testFloatStaysInRange() {
	const source = random.seeded(7)
	var withinRange = true
	var i = 0
	for i < 200 {
		const value = random.float(source)
		if value < 0.0 {
			withinRange = false
		}
		if value >= 1.0 {
			withinRange = false
		}
		i = i + 1
	}
	assert.equal(true, withinRange)
}

@Test()
fn testBytes() {
	const source = random.seeded(3)
	assert.all([
		assert.equal(8, len(random.bytes(source, 8))),
		assert.equal(0, len(random.bytes(source, 0))),
	])
}

@Test()
fn testBoolProducesBoth() {
	const source = random.seeded(11)
	var trues = 0
	var falses = 0
	var i = 0
	for i < 100 {
		if random.bool(source) {
			trues = trues + 1
		} else {
			falses = falses + 1
		}
		i = i + 1
	}
	assert.all([
		assert.equal(true, trues > 0),
		assert.equal(true, falses > 0),
		assert.equal(100, trues + falses),
	])
}

@Test()
fn testIntBetween() {
	const source = random.seeded(5)
	var withinRange = true
	var i = 0
	for i < 200 {
		const value = random.intBetween(source, 10, 20)
		if value < 10 {
			withinRange = false
		}
		if value > 19 {
			withinRange = false
		}
		i = i + 1
	}
	assert.equal(true, withinRange)
}

@Test()
fn testFloatBetween() {
	const source = random.seeded(5)
	const value = random.floatBetween(source, 2.0, 3.0)
	assert.all([
		assert.equal(true, value >= 2.0),
		assert.equal(true, value < 3.0),
	])
}

@Test()
fn testChoice() {
	const source = random.seeded(9)
	const picked = random.choice(source, ["a", "b", "c"])
	assert.all([
		assert.equal(true, picked is Some),
		assert.equal(true, arrays.contains(["a", "b", "c"], picked.value)),
		assert.equal(true, random.choice(source, []) is None),
	])
}

@Test()
fn testShuffleKeepsEveryElement() {
	const source = random.seeded(13)
	const original = [1, 2, 3, 4, 5]
	const shuffled = random.shuffle(source, original)

	var allPresent = true
	for item <- original {
		if !arrays.contains(shuffled, item) {
			allPresent = false
		}
	}
	assert.all([
		assert.equal(5, len(shuffled)),
		assert.equal(true, allPresent),
		// The input is left untouched.
		assert.equal([1, 2, 3, 4, 5], original),
	])
}

@Test()
fn testShuffleIsReproducible() {
	assert.equal(
		random.shuffle(random.seeded(21), [1, 2, 3, 4, 5, 6, 7, 8]),
		random.shuffle(random.seeded(21), [1, 2, 3, 4, 5, 6, 7, 8])
	)
}

@Test()
fn testStrongProducesValues() {
	const source = random.strong()
	assert.all([
		assert.equal(16, len(random.bytes(source, 16))),
		assert.equal(true, random.int(source, 100) < 100),
		assert.equal(true, random.float(source) < 1.0),
	])
}

@Test()
fn testFastProducesValues() {
	const source = random.fast()
	assert.all([
		assert.equal(4, len(random.bytes(source, 4))),
		assert.equal(true, random.int(source, 100) < 100),
	])
}

@Test()
fn testShuffleActuallyReorders() {
	// Without this, a shuffle that simply returned its input would satisfy every other test here.
	const original = [1, 2, 3, 4, 5, 6, 7, 8]
	var reordered = false
	var seed = 1
	for seed < 6 {
		if random.shuffle(random.seeded(seed), original) != original {
			reordered = true
		}
		seed = seed + 1
	}
	assert.equal(true, reordered)
}

@Test()
fn testStrongDiffersBetweenCalls() {
	assert.equal(false, random.bytes(random.strong(), 16) == random.bytes(random.strong(), 16))
}

// An environment providing both kinds of randomness, as a host application would.
@random.HasFastRandom(_fastOf)
@random.HasStrongRandom(_strongOf)
data Environment {
	fast: random.Source
	strong: random.Source
}

fn _fastOf(self: Environment) -> random.Source {
	self.fast
}

fn _strongOf(self: Environment) -> random.Source {
	self.strong
}

@Test()
fn testCapabilitiesAreSeparate() {
	const env = Environment(random.seeded(99), random.strong())

	const fast = random.HasFastRandom(env).random(env)
	const strong = random.HasStrongRandom(env).random(env)

	assert.all([
		// The fast one is the seeded source, so it is reproducible.
		assert.equal(random.int(random.seeded(99), 1000), random.int(fast, 1000)),
		assert.equal(16, len(random.bytes(strong, 16))),
		// Requiring one capability does not imply the other.
		assert.equal(true, env is @random.HasFastRandom),
		assert.equal(true, env is @random.HasStrongRandom),
	])
}

// A test double offering only reproducible randomness, which must not satisfy the strong capability.
@random.HasFastRandom(_onlyFastOf)
data FastOnlyEnvironment {
	source: random.Source
}

fn _onlyFastOf(self: FastOnlyEnvironment) -> random.Source {
	self.source
}

@Test()
fn testFastOnlyEnvironmentIsNotStrong() {
	const env = FastOnlyEnvironment(random.seeded(1))
	assert.all([
		assert.equal(true, env is @random.HasFastRandom),
		assert.equal(false, env is @random.HasStrongRandom),
	])
}
