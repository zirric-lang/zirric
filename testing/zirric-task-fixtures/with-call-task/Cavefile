mod with_call_task

import tasks
import fmt
import os

@tasks.Name("build")
@tasks.Alias(["b"])
@tasks.Help("Builds the project")
@tasks.Call(fn(opts: BuildTask) {
	fmt.fprintln(opts.target, os.stdout())
})
data BuildTask {
	@tasks.Flag()
	@tasks.Short('d')
	dry: Bool

	@tasks.Flag()
	target: String
}
