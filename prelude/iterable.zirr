mod code.knabel.dev.zirric_lang.zirric.prelude

// The integers from start up to but excluding end, written `[start, end)`.
// `Range(0, 3)` iterates 0, 1, 2. This is the form to reach for by default: it counts `end - start` values, so it pairs with a length.
@Countable(_rangeCount)
@Iterable(_rangeIterate)
data Range {
	// The first integer in the range.
	start: Int
	// The first integer past the range.
	end: Int
}

// The integers from start to end, both included, written `[start, end]`.
// `ClosedRange(0, 3)` iterates 0, 1, 2, 3. It is the only form that can name any non-empty span exactly, which is why `ranges` returns it.
@Countable(_closedRangeCount)
@Iterable(_closedRangeIterate)
data ClosedRange {
	// The first integer in the range.
	start: Int
	// The last integer in the range.
	end: Int
}

// The integers strictly between start and end, both excluded, written `(start, end)`.
// `OpenRange(0, 3)` iterates 1, 2.
@Countable(_openRangeCount)
@Iterable(_openRangeIterate)
data OpenRange {
	// The integer just before the range.
	start: Int
	// The integer just past the range.
	end: Int
}

// A key/value pair, as yielded when iterating a Dict.
data Pair {
	// The key the entry is stored under.
	key
	// The value stored under it.
	value
}

fn _rangeCount(v) {
	if v.start >= v.end {
		return 0
	}
	return v.end - v.start
}

fn _rangeIterate(v, yield) {
	var i = v.start
	for {
		if i >= v.end {
			return
		}
		if !yield(i) {
			break
		}
		i = i + 1
	}
}

fn _closedRangeCount(v) {
	if v.start > v.end {
		return 0
	}
	return v.end - v.start + 1
}

fn _closedRangeIterate(v, yield) {
	var i = v.start
	for {
		if i > v.end {
			return
		}
		if !yield(i) {
			break
		}
		i = i + 1
	}
}

fn _openRangeCount(v) {
	if v.start + 1 >= v.end {
		return 0
	}
	return v.end - v.start - 1
}

fn _openRangeIterate(v, yield) {
	var i = v.start + 1
	for {
		if i >= v.end {
			return
		}
		if !yield(i) {
			break
		}
		i = i + 1
	}
}

fn _arrayIterate(v, yield) {
	var i = 0
	const l = len(v)
	for {
		if i >= l {
			return
		}
		if !yield(v[i]) {
			break
		}
		i = i + 1
	}
}

fn _dictIterate(v, yield) {
	const keys = v.keys()
	var i = 0
	const l = len(keys)
	for {
		if i >= l {
			return
		}
		const key = keys[i]
		if !yield(Pair(key, v[key])) {
			break
		}
		i = i + 1
	}
}

fn _stringIterate(v, yield) {
	// Delegates to `.chars()` (decoded once) instead of indexing character-by-character, which is O(n) per index.
	for c <- v.chars() {
		if !yield(c) {
			break
		}
	}
}

fn _binaryIterate(v, yield) {
	var i = 0
	const l = len(v)
	for {
		if i >= l {
			return
		}
		if !yield(v[i]) {
			break
		}
		i = i + 1
	}
}
