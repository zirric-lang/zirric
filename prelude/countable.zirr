mod code.knabel.dev.zirric_lang.zirric.prelude

// The number of elements in a countable value, read through its `Countable` attribute.
// Counts a `String` in characters, an `Array` in elements, a `Dict` in entries and a `Binary` in bytes.
fn len(v: @Countable) -> Int {
	Countable(v).length(v)
}

extern fn _arrayLen(v: Array) -> Int
extern fn _dictLen(v: Dict) -> Int
extern fn _strLen(v: String) -> Int
extern fn _binaryLen(v: Binary) -> Int
