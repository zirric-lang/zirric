mod prelude_t

import tests
import tests.assert

@tests.Test()
fn testArrayEquality() -> Result {
	assert.all([
		assert.equal(true, [] == []),
		assert.equal(true, [1, 2, 3] == [1, 2, 3]),
		assert.equal(false, [1, 2, 3] == [1, 2]),
		assert.equal(false, [1, 2, 3] == [1, 2, 9]),
		// Deep, not just top-level.
		assert.equal(true, [1, [2, 3]] == [1, [2, 3]]),
		assert.equal(false, [1, [2, 3]] == [1, [2, 4]]),
	])
}

@tests.Test()
fn testDictEquality() -> Result {
	assert.all([
		assert.equal(true, [:] == [:]),
		assert.equal(true, [1: "a", 2: "b"] == [1: "a", 2: "b"]),
		assert.equal(false, [1: "a"] == [1: "b"]),
		assert.equal(false, [1: "a"] == [1: "a", 2: "b"]),
	])
}

data Point {
	x: Int
	y: Int
}

data Wrapper {
	inner: Point
}

@tests.Test()
fn testDataEquality() -> Result {
	assert.all([
		assert.equal(true, Point(1, 2) == Point(1, 2)),
		assert.equal(false, Point(1, 2) == Point(1, 3)),
		assert.equal(true, Wrapper(Point(1, 2)) == Wrapper(Point(1, 2))),
		assert.equal(false, Wrapper(Point(1, 2)) == Wrapper(Point(9, 9))),
		assert.equal(true, Some(1) == Some(1)),
		assert.equal(false, Some(1) == Some(2)),
		assert.equal(true, None() == None()),
		assert.equal(false, Some(1) == None()),
	])
}
