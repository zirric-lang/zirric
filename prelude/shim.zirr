mod code.knabel.dev.zirric_lang.zirric.prelude

// Anything is a value of type `Any`.
extern type Any {}
// All types are of type `AnyType`.
extern type AnyType {}

// All attributes are of type `Attribute`.
extern type Attribute {}
// All attribute types are of type `AttributeType`.
extern type AttributeType {}

// All modules are of type `AnyModule`.
extern type AnyModule {}
// All module types are of type `ModuleType`.
extern type ModuleType {}

// Returns a new collection with value added to the end, leaving the original untouched.
// An `Array` takes any value; a `Binary` takes a `Byte` or another `Binary`.
extern fn append(collection, value)

// A finite list of values.
@Countable(_arrayLen)
@Iterable(_arrayIterate)
extern type Array {}

// The true value of type `Bool`.
const true = 0 == 0
// The false value of type `Bool`.
const false = 0 != 0

// One of the two values `true` and `false`.
// Typically used for conditionals and flags. Comparisons produce one, and `if`, `for` and `&&`/`||` require one.
extern type Bool {}

// A single character from a string.
extern type Char {}

// An associative array of keys and their values.
// Can be indexed by keys.
// Iterates over Pair.
@Countable(_dictLen)
@Iterable(_dictIterate)
extern type Dict {
	// The dictionary's keys, in unspecified order.
	keys() -> Array
}

// A callable function.
extern type Func {
	// The name of the function. Might be non-deterministic for closures.
	name: String
	// The amount of function parameters to be passed.
	arity: Int
}

// A floating point number.
@Numeric(fn(f: Float) -> Float { f })
extern type Float {}

// A whole integer number.
@Numeric(fn(i: Int) -> Int { i })
extern type Int {}

union Number {
	Float
	Int
}

// A regular String.
// Can be indexed to get the Byte.
// Iterates over Char.
@Printable(fn(s: String) -> String { return s })
@Countable(_strLen)
@Iterable(_stringIterate)
extern type String {
	chars() -> [Char]
}

// A sequence of raw bytes.
// Can be indexed and iterates over Byte.
@Countable(_binaryLen)
@Iterable(_binaryIterate)
extern type Binary {}

// A single byte.
extern type Byte {}

// Represents the absence of a value.
extern const void: Void
// The type of the `void` value.
extern type Void {}

// Terminates execution with the given message.
extern fn panic(message: String) -> Void

// Returns a debug string representation of any value, regardless of whether it has a @Printable attribute. Intended for diagnostics/debugging, not user-facing output — see fmt.sprint for that.
extern fn _inspect(v: Any) -> String
