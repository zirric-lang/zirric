mod prelude

// Marks a type as an error type.
attr Error {
	// Returns a debug string representation of the error.
	debug(err) -> String
}

// Marks a union as a result type.
// Types annotated with `@AnyResult` are expected to be unions
// that follow the Ok/Err pattern.
attr AnyResult {
	toResult(self) -> Result
}

// A result type that can be either Ok or Err.
// Used for functions that can fail.
@AnyResult(fn(r) { r })
union Result {
	// The successful result.
	@AnyResult(fn(r) { r })
    data Ok {
    	// The value of the successful result.
		value
	}

	// The error result.
	@AnyResult(fn(r) { r })
	@Error(fn(err) {
		switch err.reason {
		case is String:
			err.reason
		case is @Error:
			Error(err.reason).debug(err.reason)
		case is @Printable:
			Printable(err.reason).toString(err.reason)
		case _:
			_inspect(err.reason)
		}
	})
    data Err {
    	// The failure reason
		reason
	}
}
