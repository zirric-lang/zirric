mod testproject

import cave
import tasks

@cave.Package()
data Dependencies {
  // Standard library packages are available by default
  @cave.Stdlib("tests")
  tests // this will be the name of the import

  @cave.Stdlib("prelude") // this is optional, as prelude is always included
  prelude

  @cave.Git("https://code.knabel.dev/zirric-lang/zirric")
  @cave.Version("latest")
  zirric // importable as zirric
}

// Define a task named "generate" with a help description and specify the script to run.
// Can be executed with `zirric task run generate [arg] [--dry]` (or `zirric x generate ...`).
@tasks.Name("generate")
@tasks.Help("Generates something")
@tasks.Exec("tasks/generate.zirr")
data GenerateTask {
	@tasks.Flag()
	@tasks.Name("dry")
	@tasks.Help("If true, only simulates the generation")
	isDryRun: Bool

	@tasks.Arg()
	positional: String
}
