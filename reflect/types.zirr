mod code.knabel.dev.zirric_lang.zirric.reflect

// What a module is, as metadata: everything reflection can say about it without reaching into the values it exports.
// `AnyModule` is the module itself, which members are looked up on; this is what it declared.
data Module {
	// The canonical name, e.g. "reflect.packages".
	name: String
	// The comment written above each of its `mod` declarations, joined in file name order.
	docs: String
	// The name of every module it imports, ordered by name.
	imports: [String]
	// The path of every file it was read from, ordered by name.
	sources: [String]
	// Every public declaration, ordered by name and so aligned with `members` and `memberNames`.
	declarations: [Declaration]
}

// Where a declaration was written.
data Source {
	// The file it was read from, named as the module reached it, e.g. "reflect/types.zirr".
	path: String
	// The line the declaration starts on, counted from 1, or 0 when it was not read from a file at all.
	line: Int
}

// A public declaration of a module, carrying the attributes written on it.
// Attributes are read off a Declaration exactly as off any other value, so `tests.Comment(declaration).text` and `declaration is @Deprecated` both work, even for a declaration whose value can carry none, such as a const holding an Int.
data Declaration {
	// The name it was declared under, which is the name `member` takes.
	name: String
	// The comment written above it, or the empty String when none was.
	docs: String
	// The form it was written in.
	kind: DeclarationKind
	// The declaration as it was written, without its body, e.g. "extern fn typeName(t: Any) -> String".
	signature: String
	// Where it was written.
	source: Source
}

// The form a declaration was written in, which is the keyword that introduced it.
union DeclarationKind {
	// A data declaration.
	data DataDecl

	// A union declaration.
	data UnionDecl

	// An attribute declaration.
	data AttrDecl

	// An extern type declaration.
	data TypeDecl

	// A function, declared with fn or extern fn.
	data FuncDecl

	// A constant, declared with const or extern const.
	data ConstDecl

	// A variable, declared with var.
	data VarDecl

	// A declaration in a form reflection does not describe.
	data UnknownDecl
}

// A field of a data type, carrying the attributes written on it.
// Attributes are read off a Field exactly as off any other value, so `coding.Name(field).text` and `field is @coding.Ignore` both work.
data Field {
	// The name the field was declared under.
	name: String
	// The comment written above the field, or the empty String when none was.
	docs: String
	// The type hint written on the field, which is an UnknownType when none was.
	declaredType: TypeRef
}

// A type hint as it was written.
// Hints are not enforced at runtime, so a TypeRef describes what a declaration promises rather than what a value turns out to be.
union TypeRef {
	// A type referred to by name, e.g. String or Person.
	data NamedType {
		// The name as written, which is qualified when the declaration qualified it, e.g. "String" or "prelude.Option".
		name: String
		// The type the name refers to, or None when it refers to nothing that exists as a value at runtime.
		resolved: Option
	}

	// An array type, e.g. [String].
	data ArrayType {
		element: TypeRef
	}

	// An optional type, e.g. String?.
	data OptionType {
		// What a present value holds, as written. Zirric has no generic types, so a value only has to be an Option at runtime; the element is what two written hints are told apart by.
		element: TypeRef
	}

	// A result type, e.g. String!.
	data ResultType {
		// What a successful value holds, as written, on the same terms as OptionType's element.
		element: TypeRef
	}

	// A dict type, e.g. [String: Int].
	data DictType {
		key: TypeRef
		value: TypeRef
	}

	// A function type, e.g. fn(String) -> Int.
	data FuncType {
		// One TypeRef per parameter, UnknownType where a parameter had no hint.
		parameters: [TypeRef]
		// The declared result, which is an UnknownType when the function declares none.
		returns: TypeRef
	}

	// An attribute constraint, e.g. @Iterable @Countable.
	data AttrsType {
		// One NamedType per required attribute.
		attributes: [TypeRef]
	}

	// No type hint was written.
	data UnknownType
}
