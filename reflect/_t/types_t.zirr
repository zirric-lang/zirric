import tests { Test }
import tests.assert

import reflect
import arrays

attr Label { text }

data Sample {
	plain
	@Label("id")
	name: String
	tags: [String]
	scores: [String: Int]
	parse: fn(String) -> Int
	nested: Sample
}

fn fieldNamed(name: String) -> reflect.Field {
	var found = void
	for field <- reflect.fieldsOf(Sample) {
		if field.name == name {
			found = field
		}
	}
	return found
}

@Test()
fn testFieldsAreEveryFieldInDeclarationOrder() {
	assert.equal(
		["plain", "name", "tags", "scores", "parse", "nested"],
		arrays.map(reflect.fieldsOf(Sample), fn(field) { field.name }),
	)
}

@Test()
fn testAFieldCarriesItsOwnAttributes() {
	// The attribute is read off the field exactly as it would be off a declaration.
	assert.all([
		assert.equal("id", Label(fieldNamed("name")).text),
		// A field with no attributes must not inherit its neighbour's.
		assert.equal(void, Label(fieldNamed("plain"))),
	])
}

@Test()
fn testAFieldWithoutAHintIsUnknown() {
	assert.equal(true, fieldNamed("plain").declaredType is reflect.UnknownType)
}

@Test()
fn testANamedHintResolvesToItsType() {
	const declared = fieldNamed("name").declaredType
	assert.all([
		assert.equal(true, declared is reflect.NamedType),
		assert.equal("String", declared.name),
		assert.equal(true, declared.resolved is Some),
		assert.equal("String", reflect.typeName(declared.resolved.value)),
	])
}

@Test()
fn testAHintCanNameTheTypeItIsDeclaredOn() {
	const declared = fieldNamed("nested").declaredType
	assert.all([
		assert.equal("Sample", declared.name),
		assert.equal("Sample", reflect.typeName(declared.resolved.value)),
	])
}

@Test()
fn testArrayAndDictHintsKeepTheirElementTypes() {
	const tags = fieldNamed("tags").declaredType
	const scores = fieldNamed("scores").declaredType
	assert.all([
		assert.equal(true, tags is reflect.ArrayType),
		assert.equal("String", tags.element.name),
		assert.equal(true, scores is reflect.DictType),
		assert.equal("String", scores.key.name),
		assert.equal("Int", scores.value.name),
	])
}

@Test()
fn testAFunctionHintKeepsItsParametersAndResult() {
	const parse = fieldNamed("parse").declaredType
	assert.all([
		assert.equal(true, parse is reflect.FuncType),
		assert.equal(["String"], arrays.map(parse.parameters, fn(p) { p.name })),
		assert.equal("Int", parse.returns.name),
	])
}

@Test()
fn testTypesReportWhatTheyAre() {
	assert.all([
		assert.equal(true, reflect.isDataType(Sample)),
		assert.equal(false, reflect.isUnionType(Sample)),
		assert.equal(true, reflect.isUnionType(reflect.TypeRef)),
		assert.equal(false, reflect.isDataType(reflect.TypeRef)),
		assert.equal("Sample", reflect.typeName(Sample)),
		// Anything that is not a type has no declared name, rather than being reported as one.
		assert.equal("", reflect.typeName(42)),
		assert.equal([], reflect.fieldsOf(42)),
	])
}

@Test()
fn testUnionMembersAreItsMemberTypes() {
	assert.equal(
		["NamedType", "ArrayType", "DictType", "FuncType", "AttrsType", "UnknownType"],
		arrays.map(reflect.unionMembers(reflect.TypeRef), fn(m) { reflect.typeName(m) }),
	)
}

@Test()
fn testTypeOfFindsTheTypeAValueWasBuiltFrom() {
	const value = Sample(1, "a", [], [:], fn(text) { 0 }, void)
	const found = reflect.typeOf(value)
	assert.all([
		assert.equal(true, found is Some),
		assert.equal("Sample", reflect.typeName(found.value)),
		// The type reflection finds is the very type an `is` check compares against.
		assert.equal(true, reflect.fieldsOf(found.value) is [Any]),
		assert.equal(6, len(reflect.fieldsOf(found.value))),
	])
}

@Test()
fn testFieldValuesAlignWithFields() {
	const value = Sample(1, "a", ["t"], ["k": 2], fn(text) { 0 }, void)
	assert.all([
		assert.equal(
			["plain", "name", "tags", "scores", "parse", "nested"],
			arrays.map(reflect.fieldsOf(Sample), fn(field) { field.name }),
		),
		assert.equal(1, reflect.fieldValues(value)[0]),
		assert.equal("a", reflect.fieldValues(value)[1]),
		assert.equal(["t"], reflect.fieldValues(value)[2]),
		// Anything that is not a data value simply has no fields.
		assert.equal([], reflect.fieldValues(42)),
	])
}

@Test()
fn testConstructBuildsAValueFromItsFields() {
	const built = reflect.construct(Sample, [1, "a", [], [:], void, void])
	assert.all([
		assert.equal(true, built is Ok),
		assert.equal("a", built.value.name),
		// The value must be a genuine Sample, not something merely shaped like one.
		assert.equal(true, reflect.isInstance(built.value, Sample)),
	])
}

@Test()
fn testConstructRefusesTheWrongNumberOfFields() {
	assert.all([
		assert.equal(true, reflect.construct(Sample, [1]) is Err),
		assert.equal(true, reflect.construct(42, []) is Err),
	])
}

@Test()
fn testIsInstanceDecidesAsTheIsOperatorDoes() {
	const value = Sample(1, "a", [], [:], void, void)
	assert.all([
		assert.equal(true, reflect.isInstance(value, Sample)),
		assert.equal(false, reflect.isInstance(42, Sample)),
		assert.equal(true, reflect.isInstance("x", String)),
		// A union matches its members, and an attribute type matches what carries it.
		assert.equal(true, reflect.isInstance(None(), Option)),
		assert.equal(true, reflect.isInstance(fieldNamed("name"), Label)),
		assert.equal(false, reflect.isInstance(fieldNamed("plain"), Label)),
	])
}

@Test()
fn testAttributeTypesAreRecognizable() {
	assert.all([
		assert.equal(true, reflect.isAttributeType(Label)),
		assert.equal(false, reflect.isAttributeType(Sample)),
		assert.equal(false, reflect.isAttributeType(42)),
	])
}

@Test()
fn testTypesCompareByIdentity() {
	// A type is a value now that reflection hands them out, so comparing two must answer rather than stop the program.
	assert.all([
		assert.equal(true, Sample == Sample),
		assert.equal(false, Sample == Label),
		assert.equal(true, Option == Option),
		assert.equal(false, Option == Sample),
		assert.equal(true, String == String),
		assert.equal(false, String == Int),
		// The type reflection hands back is the same value as the one written in source.
		assert.equal(true, reflect.typeOf(Sample(1, "a", [], [:], void, void)).value == Sample),
		// Comparing a type with something that is not one is simply false.
		assert.equal(false, Sample == 42),
	])
}

@Test()
fn testTypeOfAFunctionIsTheFuncType() {
	// Every compiled function reports Func as its type, so the type table must not let one of them stand in for Func itself.
	const anonymous = fn(x) { x }
	assert.all([
		assert.equal("Func", reflect.typeName(reflect.typeOf(anonymous).value)),
		assert.equal("Func", reflect.typeName(reflect.typeOf(fieldNamed).value)),
		assert.equal(true, reflect.typeOf(anonymous).value == reflect.typeOf(fieldNamed).value),
		// The type is a type, not the function that happened to be compiled last.
		assert.equal(false, reflect.isDataType(reflect.typeOf(anonymous).value)),
	])
}
