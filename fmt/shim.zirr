mod fmt

import io { Writer }
import os

// Converts a printable value to its string representation.
fn sprint(value: @Printable) {
	return Printable(value).toString(value)
}

// Writes the string representation of a printable value to a writer.
fn fprint(value: @Printable, writer: Writer) {
	const str = sprint(value)
	return writer.write(bytesFromString(str))
}

// Writes the string representation of a printable value followed by a newline to a writer.
fn fprintln(value: @Printable, writer: Writer) {
	const str = sprint(value) + "\n"
	return writer.write(bytesFromString(str))
}

// Prints the string representation of a printable value followed by a newline to stdout.
fn println(value: @Printable) {
	return fprintln(value, os.stdout())
}
