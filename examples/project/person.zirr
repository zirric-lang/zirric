mod code.knabel.dev.zirric_lang.example

import fmt
import os

// Person is always a present SomePerson, which it has to say itself: a union's attributes are not read off a value of one of its members.
@AnyOption(fn(p) { Some(p) })
@Printable(fn(p) { p.name })
data Person {
	name: String
	age: Int
}

@AnyOption(fn(v) {
	switch v {
	case is None:
		v
	case _:
		Some(v)
	}
})
union SomePerson {
	Person
	None
}

const peter: SomePerson = Person("Peter", 42)

fn greet(person: SomePerson) -> String {
	var name = switch person {
	case is Person:
		person.name
	case _:
		"World"
	}

	return "Hello " + name
}

fmt.fprintln(greet(peter), os.stdout())
