mod example

data Person {
	name: String
	age: Int
}

@AnyOption()
union SomePerson {
	Person
	None
}

@AnyOption()
const peter: Person = Person("Peter", 42)

fn greet(person: SomePerson) -> String {
	var name = switch person {
	case is Person:
		person
	case _:
		"World"
	}
	
	return "Hello" + name
}
