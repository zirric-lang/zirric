mod example

import fmt

@Printable(fn(p) { p.name })
data Person {
	name: String
	age: Int
}

@AnyOption()
union SomePerson {
	Person
	None
}

const peter: SomePerson = Person("Peter", 42)

fn greet(person: SomePerson) -> String {
	var name = switch person {
	case is Person:
		person.name
	case _:
		"World"
	}
	
	return "Hello " + name
}

fmt.println(greet(peter))
