mod code.knabel.dev.zirric_lang.zirric.dicts._t

import tests { Test }
import tests.assert

import dicts

@Test()
fn testIsEmpty() -> Result {
	assert.all([
		assert.equal(true, dicts.isEmpty([:])),
		assert.equal(false, dicts.isEmpty(["a": 1])),
	])
}

@Test()
fn testMap() -> Result {
	assert.equal(
		["a": "a1", "b": "b2"],
		dicts.map(["a": 1, "b": 2], fn(k, v) { k + v })
	)
}

@Test()
fn testMapKeys() -> Result {
	assert.equal(
		["a!": 1, "b!": 2],
		dicts.mapKeys(["a": 1, "b": 2], fn(k) { k + "!" })
	)
}

@Test()
fn testMapValues() -> Result {
	assert.equal(
		["a": 10, "b": 20],
		dicts.mapValues(["a": 1, "b": 2], fn(v) { v * 10 })
	)
}

@Test()
fn testMapPairs() -> Result {
	assert.equal(
		["a!": 10, "b!": 20],
		dicts.mapPairs(["a": 1, "b": 2], fn(p) { Pair(p.key + "!", p.value * 10) })
	)
}

@Test()
fn testFilter() -> Result {
	assert.all([
		assert.equal(["b": 2], dicts.filter(["a": 1, "b": 2], fn(k, v) { v > 1 })),
		assert.equal(["a": 1], dicts.filter(["a": 1, "b": 2], fn(k, v) { k == "a" })),
		assert.equal([:], dicts.filter(["a": 1], fn(k, v) { false })),
	])
}

@Test()
fn testReduce() -> Result {
	assert.all([
		assert.equal(3, dicts.reduce(["a": 1, "b": 2], 0, fn(acc, k, v) { acc + v })),
		assert.equal(0, dicts.reduce([:], 0, fn(acc, k, v) { acc + v })),
	])
}

@Test()
fn testHasKey() -> Result {
	assert.all([
		assert.equal(true, dicts.hasKey(["a": 1], "a")),
		assert.equal(false, dicts.hasKey(["a": 1], "b")),
		// A key holding void is still a key, which indexing alone cannot tell apart from absence.
		assert.equal(true, dicts.hasKey(["a": void], "a")),
		assert.equal(false, dicts.hasKey([:], "a")),
	])
}
