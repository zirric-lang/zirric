
(*
This file declares the Zirric syntax and will be updated.
It is used as formal reference in EBNF format, but the actual parser is not generated from it.

The names of the productions follow a naming schema to be used within parsing implementations.

All CAPS productions represent tokens and the basic building blocks.
Productions prefixed with an _underscore are just helper productions and are not standardized.
Other productions should be treated as the external API of the grammar.
For example tree-sitter queries which may be written by third parties rely on its naming.
Some implementations will support fields on the AST.
In those cases, the corresponding nodes are prefixed with the production name - but in snake_case.
*)

(* Tokens *)

IDENT = (_letter|"_") {_alpha_num|"_"}; (* special tokens take precedence *)
STRING = '"',  '"';
INT = "0" | {"1"..."9", _alpha_num};
FLOAT = "";

BANG = "!";
PLUS = "+";
MINUS = "-";
ASTERISK = "*";
SLASH = "/";

LT = "<";
GT = ">";
EQ = "==";
NEQ = "!=";
GTE = ">=";
LTE = "<=";
AND = "&&";
OR = "||";

ASSIGN = "=";
ARROW = "->";
COLON = ":";
DOT = ".";
COMMA = ",";
LPAREN = "(";
RPAREN = ")";
LBRACE = "{";
RBRACE = "}";
LBRACKET = "[";
RBRACKET = "]";
AT = "@";

MODULE = "mod";
IMPORT = "import";
UNION = "union";
DATA = "data";
EXTERN = "extern";
FUNCTION = "fn";
CONST = "const";
VAR = "var";
ATTRIBUTE = "attr";
TYPE = "type";
RETURN = "return";
IF = "if";
ELSE = "else";
FOR = "for";
SWITCH = "switch";
CASE = "case";
IS = "is";
TRUE = "true";
FALSE = "false";
BLANK = "_";

(* declarations and statements *)
SourceFile = [ _shebang ], [Module], {_topLevelDeclaration} ;

_shebang = "#!", { _anyInlineChar }, "\n";
Module = MODULE, Identifier;
module_name = Identifier;

_topLevelDeclaration = Import |
	{Attribute}, (Union | Data | Extern | Attribute_decl | Function | Const | Var) |
	_complexExpression;

_scopeLevelDeclaration = Function |
	Const |
	Var |
	Union |
	Data;

Import = IMPORT,
	[import_alias, ASSIGN],
	import_name,
	[LBRACE, import_members, RBRACE];
import_alias = Identifier;
import_name = ImportModule;
import_members = { Identifier, [_list_separator] };
ImportModule = Identifier, {DOT, Identifier};

Const = CONST, const_name, [COLON, TypeHint], ASSIGN, const_value;
const_name = Identifier;
const_value = _complex_expression;

Var = VAR, var_name, [COLON, TypeHint], ASSIGN, var_value;
var_name = Identifier;
var_value = _complex_expression;

Function = FUNCTION, function_name, LPAREN, [_params], RPAREN, [ARROW, TypeHint], LBRACE, _block, RBRACE;
function_name = Identifier;

Data = DATA, data_name, [LBRACE, {_data_field}, RBRACE];
data_name = Identifier;
_data_field = {Attribute}, Identifier, [COLON, TypeHint], [_list_separator];

Union = UNION, union_name, LBRACE, {_union_member}, RBRACE;
union_name = Identifier;
_union_member = {Attribute}, (Data | StaticReference), [_list_separator];

Attribute_decl = ATTRIBUTE, attr_name, [LBRACE, {_data_field}, RBRACE];
attr_name = Identifier;

Extern = extern_type | extern_func | extern_value;
extern_type = EXTERN, TYPE, extern_type_name, [LBRACE, {_data_field}, RBRACE];
extern_type_name = Identifier;

extern_func = EXTERN, FUNCTION, extern_func_name, LPAREN, [_params], RPAREN;
extern_func_name = Identifier;

extern_value = EXTERN, CONST, extern_value_name, [COLON, TypeHint];
extern_value_name = Identifier;

Attribute = AT, StaticReference, LPAREN, [_args], RPAREN;

(* type hints *)
TypeHint = TypeHintRef | TypeHintArray | TypeHintDict | TypeHintFunc | TypeHintAttrs;
TypeHintRef = StaticReference;
TypeHintArray = LBRACKET, TypeHint, RBRACKET;
TypeHintDict = LBRACKET, TypeHint, COLON, TypeHint, RBRACKET;
TypeHintFunc = FUNCTION, LPAREN, [_params], RPAREN, [ARROW, TypeHint];
TypeHintAttrs = {AT, StaticReference};

(* parameters *)
_params = Parameter, {_list_separator, Parameter};
Parameter = Identifier, [COLON, TypeHint];

(* expressions *)

Identifier = IDENT;
StaticReference = Identifier, {DOT, Identifier};

Closure = FUNCTION, LPAREN, [_params], RPAREN, [ARROW, TypeHint], LBRACE, _block, RBRACE;

SwitchExpr = SWITCH, _expression, LBRACE, {SwitchCase}, RBRACE;
SwitchCase = CASE, [IS, TypeHint | _expression], LBRACE, _block, RBRACE;

IsExpr = _expression, IS, TypeHint;

(* statements *)
_block = {_statement};
_statement = _scopeLevelDeclaration | Return | If | For | SwitchStmt | _complexExpression;

Return = RETURN, [_expression];
If = IF, _expression, LBRACE, _block, RBRACE, {ELSE, IF, _expression, LBRACE, _block, RBRACE}, [ELSE, LBRACE, _block, RBRACE];
For = FOR, [Identifier, COLON], _expression, LBRACE, _block, RBRACE;

SwitchStmt = SWITCH, _expression, LBRACE, {StmtSwitchCase}, RBRACE;
StmtSwitchCase = CASE, [IS, TypeHint | _expression], LBRACE, _block, RBRACE;

(* Helpers *)
_letter = "a"..."z"|"A"..."Z";
_digit = "0"..."9";
_alpha_num = _letter|_digit;
_any_inline_char = _alpha_num|"_"|"/"|".";
_list_separator = COMMA;
_expression = (* see parser for full precedence climbing *);
_complex_expression = _expression;
_args = _expression, {_list_separator, _expression};
