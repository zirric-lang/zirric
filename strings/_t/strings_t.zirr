mod code.knabel.dev.zirric_lang.zirric.strings._t

import tests { Test }
import tests.assert

import results
import strings

@Test()
fn testFrom() -> Result {
	assert.all([
		assert.equal("a", strings.from('a')),
		assert.equal("hello", strings.from("hello")),
	])
}

@Test()
fn testCount() -> Result {
	assert.all([
		assert.equal(0, strings.count("")),
		assert.equal(5, strings.count("hello")),
		// count counts characters, not bytes — len() counts bytes.
		assert.equal(4, strings.count("café")),
		assert.equal(5, len("café")),
	])
}

@Test()
fn testCharAt() -> Result {
	assert.all([
		assert.equal('h', strings.charAt("hello", 0)),
		assert.equal('o', strings.charAt("hello", 4)),
		// Character index, not byte index — é is 2 bytes but 1 character.
		assert.equal('l', strings.charAt("héllo", 2)),
	])
}

@Test()
fn testSlice() -> Result {
	assert.all([
		assert.equal("ell", strings.slice("hello", 1, 4)),
		assert.equal("", strings.slice("hello", 2, 2)),
		assert.equal("hello", strings.slice("hello", 0, 5)),
		// Character-based, doesn't split the multi-byte é.
		assert.equal("éll", strings.slice("héllo", 1, 4)),
	])
}

@Test()
fn testRange() -> Result {
	assert.all([
		assert.equal("ell", strings.range("hello", Range(1, 4))),
		assert.equal("ell", strings.range("hello", ClosedRange(1, 3))),
		assert.equal("ell", strings.range("hello", OpenRange(0, 4))),
	])
}

@Test()
fn testIsEmpty() -> Result {
	assert.all([
		assert.equal(true, strings.isEmpty("")),
		assert.equal(false, strings.isEmpty("x")),
	])
}

@Test()
fn testIsDigit() -> Result {
	assert.all([
		assert.equal(true, strings.isDigit('7')),
		assert.equal(true, strings.isDigit("2026")),
		assert.equal(false, strings.isDigit("12a")),
		assert.equal(false, strings.isDigit('a')),
		// Empty text has no digits, so it is not all digits.
		assert.equal(false, strings.isDigit("")),
		// Unicode-aware — Arabic-Indic digits count as digits.
		assert.equal(true, strings.isDigit("٣٤")),
	])
}

@Test()
fn testIsLetter() -> Result {
	assert.all([
		assert.equal(true, strings.isLetter('a')),
		assert.equal(true, strings.isLetter("hello")),
		assert.equal(false, strings.isLetter("hello world")),
		assert.equal(false, strings.isLetter("abc1")),
		assert.equal(false, strings.isLetter('7')),
		assert.equal(false, strings.isLetter("")),
		// Unicode-aware — accented and non-Latin letters count as letters.
		assert.equal(true, strings.isLetter("café")),
		assert.equal(true, strings.isLetter("日本語")),
	])
}

@Test()
fn testIsSpace() -> Result {
	assert.all([
		assert.equal(true, strings.isSpace(' ')),
		assert.equal(true, strings.isSpace('\t')),
		assert.equal(true, strings.isSpace("  ")),
		assert.equal(true, strings.isSpace(" \t\n")),
		assert.equal(false, strings.isSpace("a b")),
		assert.equal(false, strings.isSpace('a')),
		assert.equal(false, strings.isSpace("")),
		// Unicode-aware — a non-breaking space is whitespace.
		assert.equal(true, strings.isSpace('\u00a0')),
		assert.equal(true, strings.isSpace("\u00a0\u2003")),
	])
}

@Test()
fn testContains() -> Result {
	assert.all([
		assert.equal(true, strings.contains("hello", "ell")),
		assert.equal(true, strings.contains("hello", "")),
		assert.equal(false, strings.contains("hello", "xyz")),
	])
}

@Test()
fn testHasPrefix() -> Result {
	assert.all([
		assert.equal(true, strings.hasPrefix("hello", "he")),
		assert.equal(false, strings.hasPrefix("hello", "lo")),
	])
}

@Test()
fn testHasSuffix() -> Result {
	assert.all([
		assert.equal(true, strings.hasSuffix("hello", "lo")),
		assert.equal(false, strings.hasSuffix("hello", "he")),
	])
}

@Test()
fn testFirstIndexOf() -> Result {
	assert.all([
		assert.equal(2, strings.firstIndexOf("hello", "l").value),
		// Character index, not byte index — the é before it is 2 bytes.
		assert.equal(2, strings.firstIndexOf("héllo", "l").value),
		assert.equal(true, strings.firstIndexOf("hello", "xyz") is None),
	])
}

@Test()
fn testLastIndexOf() -> Result {
	assert.all([
		assert.equal(3, strings.lastIndexOf("hello", "l").value),
		assert.equal(true, strings.lastIndexOf("hello", "xyz") is None),
	])
}

@Test()
fn testReplace() -> Result {
	assert.all([
		assert.equal("bonono", strings.replace("banana", "a", "o")),
		assert.equal("hello", strings.replace("hello", "xyz", "o")),
	])
}

@Test()
fn testReplaceFirst() -> Result {
	assert.equal("bonana", strings.replaceFirst("banana", "a", "o"))
}

@Test()
fn testReplaceLast() -> Result {
	assert.equal("banano", strings.replaceLast("banana", "a", "o"))
}

@Test()
fn testSplit() -> Result {
	const parts = strings.split("a,b,c", ",")
	assert.all([
		assert.equal(3, len(parts)),
		assert.equal("a", parts[0]),
		assert.equal("b", parts[1]),
		assert.equal("c", parts[2]),
	])
}

@Test()
fn testJoin() -> Result {
	assert.all([
		assert.equal("a, b, c", strings.join(["a", "b", "c"], ", ")),
		assert.equal("", strings.join([], ", ")),
	])
}

@Test()
fn testConcat() -> Result {
	assert.all([
		assert.equal("", strings.concat([])),
		assert.equal("abc", strings.concat(["a", "b", 'c'])),
	])
}

@Test()
fn testRepeat() -> Result {
	assert.all([
		assert.equal("", strings.repeat("ab", 0)),
		assert.equal("ababab", strings.repeat("ab", 3)),
	])
}

@Test()
fn testToUpperToLower() -> Result {
	assert.all([
		assert.equal("HELLO", strings.toUpper("Hello")),
		assert.equal("hello", strings.toLower("Hello")),
		// toUpper/toLower preserve whether the argument was a Char or a String.
		assert.equal(true, strings.toUpper('a') == 'A' && strings.toUpper("aa") == strings.toUpper("AA")),
		assert.equal(true, strings.toUpper('a') is Char),
		assert.equal(true, strings.toUpper("a") is String),
		assert.equal('a', strings.toLower('A')),
		assert.equal("a", strings.toLower("A")),
	])
}

@Test()
fn testTrim() -> Result {
	assert.all([
		assert.equal("hi", strings.trim("  hi  ")),
		assert.equal("hi", strings.trim("hi")),
	])
}

@Test()
fn testTrimPrefixSuffix() -> Result {
	assert.all([
		assert.equal("llo", strings.trimPrefix("hello", "he")),
		assert.equal("hello", strings.trimPrefix("hello", "xyz")),
		assert.equal("hel", strings.trimSuffix("hello", "lo")),
		assert.equal("hello", strings.trimSuffix("hello", "xyz")),
	])
}

@Test()
fn testQuote() -> Result {
	assert.all([
		assert.equal("\"hi\"", strings.quote("hi")),
		assert.equal("\"\"", strings.quote("")),
		assert.equal("\"a\\nb\"", strings.quote("a\nb")),
		assert.equal("\"a\\\"b\"", strings.quote("a\"b")),
		// A Char is quoted as a String.
		assert.equal("\"a\"", strings.quote('a')),
	])
}

@Test()
fn testUnquote() -> Result {
	assert.all([
		assert.equal("hi", strings.unquote("\"hi\"").value),
		assert.equal("", strings.unquote("\"\"").value),
		assert.equal("a\nb", strings.unquote("\"a\\nb\"").value),
		// Both literal forms are accepted.
		assert.equal("a", strings.unquote("'a'").value),
		// Unquoted text is not a literal, and neither is a half-quoted one.
		assert.equal(true, results.isErr(strings.unquote("hi"))),
		assert.equal(true, results.isErr(strings.unquote("\"unterminated"))),
	])
}

@Test()
fn testQuoteRoundTrips() -> Result {
	const text = "café \"quoted\"\tand\ttabbed"
	assert.equal(text, strings.unquote(strings.quote(text)).value)
}
