mod xprelude

import code.knabel.dev.zirric_lang.zirric.future {
	Proposal
}

// ZE-010: Iterable
// https://zirric.knabel.dev/proposals/ZE-010-iterable
const ZE_010 = "https://zirric.knabel.dev/proposals/ZE-010-iterable"

// Denotes that a type is countable and has a length.
@Proposal(ZE_010)
attr Countable {
  length(value: @Countable) -> Int
}

// Marks a type as iterable.
// This allows using `for ... <- ...` on the type.
@Proposal(ZE_010)
attr Iterable {
  iterate(value: @Iterable, yield: fn(Any) -> Bool)
}

// @Proposal(ZE_010)
// @Countable(fn(v) { return v.length })
// @Iterable(_arrayIterate)
// extern type Array {
//   length: Int
// }

// @Proposal(ZE_010)
// @Countable(fn(v) { return v.length })
// @Iterable(_dictIterate)
// extern type Dict {
//   length: Int
//   keys: Array
// }

// Represents an open range of integers from start (inclusive) to end (exclusive).
// Can be created using the syntax `start..<end`.
@Proposal(ZE_010)
@Countable(_rangeCount)
@Iterable(_rangeIterate)
data Range {
  start: Int
  end: Int
}

// Represents a closed range of integers from start (inclusive) to end (inclusive).
// Can be created using the syntax `start...end`.
@Proposal(ZE_010)
@Countable(_rangeCount)
@Iterable(_rangeIterate)
data ClosedRange {
  start: Int
  end: Int
}

// @Proposal(ZE_010)
// @Countable(fn(v) { v.length })
// @Iterable(_stringIterate)
// extern type String {
//   length: Int
// }
fn _arrayIterate(v, yield) {
  const i = 0
  const l = v.length
  for {
    if !yield(v[i]) {
      break
    }
    i = i+1
    if i == l {
      return
    }
  }
}

fn _dictIterate(v, yield) {
  for k <- v.keys {
    if !yield(v[k]) {
      break
    }
  }
}

fn _stringIterate(v, yield) {
  const i = 0
  const l = v.length
  for {
    if !yield(v[i]) {
      break
    }
    i = i+1
    if i == l {
      return
    }
  }
}

fn _rangeCount(v) {
  if v.start >= v.end {
    return 0
  }
  return v.end - v.start
}

fn _rangeIterate(v, yield) {
  const i = v.start
  const l = v.end
  for {
    if !yield(i) {
      break
    }
    i = i+1
    if i == l {
      return
    }
  }
}

fn _closedRangeCount(v) {
  if v.start >= v.end {
    return 0
  }
  return v.end - v.start + 1
}

fn _closedRangeIterate(v, yield) {
  const i = v.start
  const l = v.end
  for {
    if !yield(i) {
      break
    }
    i = i+1
    if i == l {
      return
    }
  }
  yield(l)
}
