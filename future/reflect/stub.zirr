mod xreflect

data Field {
    @String name

    @Type(AnyType) type

    @Array
    @ItemType(Attribute)
    attributes
}

data Attribute {
    @AnyAttribute attributeType
    @Array args
}

attr Name {
    @String name
}

@Returns(Type)
fn typeOf(@Any value) {}

@Returns(Array(Field))
fn fieldsOf(@Type typeValue) {}

@Returns(Result)
@OkType(AnyAttribute)
fn attribute(@Field field, @AttributeType attributeType) {}

@Returns(Bool)
fn hasAttribute(@Field field, @AttributeType attributeType) {}
