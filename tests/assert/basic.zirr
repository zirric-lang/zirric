mod assert

import fmt
import results

fn all(res: [@AnyResult]) -> Result {
	results.all(res)
}

fn equal(expect, got) -> Result {
	if expect == got {
		Ok(true)
	} else {
		Err("expected " + fmt.sprint(expect) + ", got " + fmt.sprint(got))
	}
}

fn isTrue(val) -> Result {
	equal(true, val)
}

fn isFalse(val) -> Result {
	equal(false, val)
}

fn isOk(val) -> Result {
	switch val {
	case is Ok:
	case is Err:
		Err("expected an ok value, got " + fmt.sprint(val))
	case is @AnyResult:
		const res = AnyResult(val).toResult(val)
		switch res {
		case is Ok:
		case _:
			Err("expected an ok result, got " + fmt.sprint(val))
		}
	case _:
		Err("expected an ok result, got " + fmt.sprint(val))
	}
}

fn isErr(val) -> Result {
	switch val {
	case is Err:
	case is @AnyResult:
		const res = AnyResult(val).toResult(val)
		switch res {
		case is Err:
		case _:
			Err("expected an err result, got " + fmt.sprint(val))
		}
	case _:
		Err("expected an err result, got " + fmt.sprint(val))
	}
}

fn isError(val) -> Result {
	switch val {
	case is @Error:
	case _:
		Err("expected an error, got " + fmt.sprint(val))
	}
}

fn fail(reason) -> Result {
	Err(reason)
}
