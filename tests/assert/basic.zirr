mod assert

import results

fn all(res: [@AnyResult]) -> Result {
	results.all(res)
}

fn equal(expect, got) -> Result {
	if expect == got {
		Ok(true)
	} else {
		Err("expected "+expect+", got "+got)
	}
}

fn isTrue(val) -> Result {
	equal(true, val)
}

fn isFalse(val) -> Result {
	equal(false, val)
}

fn isOk(val) -> Result {
	switch val {
	case is Ok:
	case is Err:
		Err("expected ok value, got" + val)
	case is @AnyResult:
		const res = AnyResult(val).toResult(val)
		switch res {
		case is Ok:
		case _:
			Err("expected ok result, got" + val)
		}
	case _:
		Err("expected ok result, got" + val)
	}
}

fn isErr(val) -> Result {
	switch val {
	case is Err:
	case is @AnyResult:
		const res = AnyResult(val).toResult(val)
		switch res {
		case is Err:
		case _:
			Err("expected err result, got" + val)
		}
	case _:
		Err("expected an err result, got VAL")
	}
}

fn isError(val) -> Result {
	switch val {
	case is @Error:
	case _:
		Err("expected an error, got VAL")
	}
}

fn fail(reason) -> Result {
	Err(reason)
}
