mod code.knabel.dev.zirric_lang.zirric.tests.tap

import io
import tests { TestEvent }
import fmt

fn reporter(writer: @io.Writer) -> fn(TestEvent) {
	var i = 0
	return fn(ev: TestEvent) {
		switch ev {
		case is tests.Discovered:
			fmt.fprintln(writer, "TAP version 14")
			fmt.fprintln(writer, "1.." + len(ev.cases))
		case is tests.Skipped:
			i += 1

			fmt.fprint(writer, "ok " + i + " " + ev.test.name)
			fmt.fprintln(writer, _sprintDirective(ev.test))

		case is tests.Finished:
			i += 1

			switch ev.outcome {
			case is Ok:
				fmt.fprint(writer, "ok " + i + " " + ev.test.name)
				fmt.fprintln(writer, _sprintDirective(ev.test))
			case is Err:
				fmt.fprint(writer, "not ok " + i + " - " + ev.test.name)
				fmt.fprintln(writer, _sprintDirective(ev.test))
				fmt.fprintln(writer, "# " + Error(ev.outcome).debug(ev.outcome))
			}
		case is tests.Completed:
			fmt.fprintln(writer, "")
			fmt.fprint(writer, "# PASS")
			fmt.fprint(writer, '\t')
			fmt.fprint(writer, "FAIL")
			fmt.fprint(writer, '\t')
			fmt.fprint(writer, "SKIP")
			fmt.fprint(writer, '\t')
			fmt.fprintln(writer, "TODO")

			fmt.fprint(writer, "# ")
			fmt.fprint(writer, len(ev.report.pass))
			fmt.fprint(writer, '\t')
			fmt.fprint(writer, len(ev.report.fail))
			fmt.fprint(writer, '\t')
			fmt.fprint(writer, len(ev.report.skip))
			fmt.fprint(writer, '\t')
			fmt.fprint(writer, len(ev.report.todo))
			fmt.fprint(writer, "\t")
			fmt.fprintln(writer, "")
			fmt.fprintln(writer, "")
			if len(ev.report.fail) > 0 {
				fmt.fprintln(writer, "# FAILED!")
			} else {
				fmt.fprintln(writer, "# PASSED!")
			}
		}
	}
}

fn _sprintDirective(tc: tests.TestCase) -> String {
	const comment = if tc.comment != "" {
		": " + tc.comment
	} else {
		""
	}

	if tc.skipped {
		return " # SKIP" + comment
	}

	switch tc.details {
	case is tests.TestCaseDetailsOnly:
		return "\n# ONLY" + comment
	case is tests.TestCaseDetailsSkip:
		return " # SKIP" + comment
	case is tests.TestCaseDetailsTodo:
		return " # TODO" + comment
	case _:
		return ""
	}
}
