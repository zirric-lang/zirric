mod code.knabel.dev.zirric_lang.zirric.options._t

import tests { Test }
import tests.assert

import options

@Test()
fn testFrom() {
	assert.all([
		assert.equal(true, options.from(None()) is None),
		assert.equal(true, options.from(Some(1)) is Some),
		assert.equal(true, options.from(42) is Some),
		assert.equal(1, options.from(Some(1)).value),
		assert.equal(42, options.from(42).value),
	])
}

@Test()
fn testIsSomeIsNone() {
	assert.all([
		assert.equal(true, options.isSome(Some(1))),
		assert.equal(false, options.isNone(Some(1))),
		assert.equal(true, options.isNone(None())),
		assert.equal(false, options.isSome(None())),
		assert.equal(true, options.isSome(42)),
	])
}

@Test()
fn testMap() {
	assert.all([
		assert.equal(20, options.map(Some(2), fn(v) { v * 10 }).value),
		assert.equal(true, options.map(None(), fn(v) { v * 10 }) is None),
		assert.equal(20, options.map(2, fn(v) { v * 10 }).value),
	])
}

@Test()
fn testFlatMap() {
	assert.all([
		assert.equal(20, options.flatMap(Some(2), fn(v) { Some(v * 10) }).value),
		assert.equal(true, options.flatMap(Some(2), fn(v) { None() }) is None),
		assert.equal(true, options.flatMap(None(), fn(v) { Some(v) }) is None),
	])
}

@Test()
fn testOr() {
	assert.all([
		assert.equal(2, options.or(Some(2), 99)),
		assert.equal(99, options.or(None(), 99)),
		assert.equal(2, options.or(2, 99)),
	])
}
